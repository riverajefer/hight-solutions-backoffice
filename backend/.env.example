# Database
# For development: Use your Supabase PostgreSQL URL
# For staging/production: Use Railway PostgreSQL URL
DATABASE_URL="postgresql://user:password@host:port/database"

# JWT Configuration
# IMPORTANT: Generate strong secrets using: openssl rand -base64 32
JWT_ACCESS_SECRET="your-strong-secret-here"
JWT_REFRESH_SECRET="your-strong-refresh-secret-here"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Application
PORT=3000
NODE_ENV=development
# Swagger (/api) solo se publica en desarrollo. Opcional: true lo habilita
# también en staging/producción (expone el mapa completo del API).
SWAGGER_ENABLED=

# Asistencia: hora de cierre automático de la jornada (HH:mm, hora Colombia).
# Quien hace horas extra vuelve a marcar entrada; lo que siga abierto a las 23:59 se cierra.
ATTENDANCE_WORKDAY_END=19:00

# Logging & Observability (Grafana Cloud Loki)
# LOG_LEVEL: trace | debug | info | warn | error | fatal (por defecto: info)
LOG_LEVEL=info
# En desarrollo dejar LOKI_* vacías para usar salida legible con pino-pretty.
# En staging/producción, obtener estos valores en Grafana Cloud → Connections → Loki
# y configurarlos en el dashboard de Railway (NO committear valores reales).
LOKI_HOST=
LOKI_USER=
LOKI_API_KEY=

# Frontend URL: se usa para CORS y para armar enlaces al frontend.
# Si no trae esquema se asume https:// (en Railway está como "crmhighsolutions.com").
FRONTEND_URL="http://localhost:5173"
# Opcional: orígenes permitidos por CORS, separados por comas. Si se define,
# reemplaza a FRONTEND_URL para CORS (útil con www y sin www, o varios dominios).
# En desarrollo siempre se permite además http://localhost:5173.
CORS_ORIGINS=

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT_URL=https://your-s3-endpoint.com
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_SIGNED_URL_EXPIRATION=3600

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=El sistema se encuentra en mantenimiento. Por favor intenta más tarde.

# WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v22.0
# Meta App Secret — en Meta for Developers → tu App → Configuración → Básica → App Secret
# Usado para verificar la firma X-Hub-Signature-256 de los webhooks entrantes
WHATSAPP_APP_SECRET=
